#!/bin/sh
# Serenity-UAV pre-commit guard suite:
# 1. Block corrupt/unloadable KiCad files (In2.Cu / Edge.Cuts GUI-save corruption)
# 2. Sanitize code comments, design specs, and bug reports (remove TODO/issue refs, PII)
# 3. Check for exploitable failure patterns that require immediate bug report
#
# Enable once per clone:  git config core.hooksPath .githooks

set -e
TOPDIR="$(git rev-parse --show-toplevel)"

# KiCad load validation
python3 "$TOPDIR/tools/precommit_kicad_load.py" || exit 1

# Sanitization and delinting
python3 "$TOPDIR/tools/precommit_sanitize.py" || exit 1

# Update indexes
python3 "$TOPDIR/tools/precommit_index.py" || exit 1

# Automatically stage the updated index files
git add "$TOPDIR/PROJECT_INDEX.md" "$TOPDIR/ARCHIVE_INDEX.md" "$TOPDIR/tools/index_tags.json"
