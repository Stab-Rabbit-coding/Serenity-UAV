root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.scad]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.c]
indent_style = space
indent_size = 4

[*.h]
indent_style = space
indent_size = 4

# Makefiles require literal tab indentation for recipe lines (a hard rule of
# GNU make / POSIX make); spaces are a syntax error.  Declare tab indent so the
# EDITORCONFIG check does not flag recipe tabs.
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
