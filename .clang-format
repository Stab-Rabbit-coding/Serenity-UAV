---
# clang-format configuration for the Serenity UAV firmware sources.
#
# CLAUDE.md mandates 4-space indentation for all code "whether or not
# required by the language" — this overrides clang-format's Google-style
# default of 2.  Macro-value and struct-member alignment are enabled to
# match the column-aligned commenting style already hand-applied across
# avionics/firmware/common/include/*.h.
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 80
# Boolean form (not the newer Never/CaseSensitive/CaseInsensitive enum) --
# the clang-format bundled in the CI super-linter container predates the
# enum syntax and fails to parse this file with "invalid boolean" if the
# enum form is used.  false is the exact behavioral equivalent of Never.
SortIncludes: false
AlignConsecutiveMacros: AcrossEmptyLinesAndComments
AlignConsecutiveDeclarations: true
AlignTrailingComments: true
PointerAlignment: Left
