                        <property><name>dds.sec.access.plugin</name><value>builtin.Access-Permissions</value></property>
                        <property><name>dds.sec.access.builtin.Access-Permissions.permissions_ca</name><value>file:///etc/serenity/pki/permissions_ca.pem</value></property>
                        <property><name>dds.sec.access.builtin.Access-Permissions.governance</name><value>file:///etc/serenity/pki/governance.smime</value></property>
