  (symbol (lib_id "TACCO:S_SD-WB") (at 139.70 297.18 0) (unit 1)
    (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "b7000000-0000-0000-0000-000000000852")
    (property "Reference" "SD-WB" (at 139.70 280.67 0) (effects (font (size 1.27 1.27))))
    (property "Value" "ATF16V8BQL-15XI" (at 139.70 313.69 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Package_SO:TSSOP-20_4.4x6.5mm_P0.65mm" (at 139.70 297.18 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Datasheet" "atf16v8bql.pdf Ordering Information (20X = TSSOP, 4.4mm wide) [REF-SENSOR-037] — TSSOP-20 chosen over the SOIC-20W package for a smaller board footprint, per the user's XO board-area-reduction directive (same pin numbering, standard PAL16V8 pinout). Used as a logging write-block interlock: gates the NOR flash /WP line. The JEDEC fuse map (logic equations) is a firmware/programming deliverable, out of scope for this schematic pass — every pin is wired to a real net so ERC is complete; unused I/O macrocells (12-18) are left as no-connects, standard practice for a partially-used PAL/GAL." (at 139.70 297.18 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "MPN" "ATF16V8BQL-15XI" (at 139.70 297.18 0) (effects (font (size 1.27 1.27)) (hide yes)))
