[flake8]
exclude =
    archives/,
    graphical-build-guide/,
    .git,
    __pycache__,
    build,
    dist,
max-line-length = 100
per-file-ignores =
    # Generated Markdown table rows are long by nature; black's slice spacing trips E203.
    tools/sync_operators_manual.py: E501,E203
    # Plan-folder analysis scripts: sys.path is set before imports and lines carry data tables.
    docs/plans/*/tools/*.py: E227,E401,E402,E501,E741,F401
